+  public static async CloseOpenFile(filePath: string): Promise<void> {
+    const matchingEditors = vscode.window.visibleTextEditors.filter(editor => {
+      return FileService.IsSamePath(editor.document.uri.fsPath, filePath);
+    });
+
+    for (const editor of matchingEditors) {
+      await vscode.window.showTextDocument(
+        editor.document,
+        editor.viewColumn,
+        false
+      );
+      await vscode.commands.executeCommand(
+        "workbench.action.closeActiveEditor"
+      );
+    }
+
+    const hasUnsavedChanges = vscode.workspace.textDocuments.some(document => {
+      return (
+        document.uri.scheme === "file" &&
+        !document.isClosed &&
+        document.isDirty &&
+        FileService.IsSamePath(document.uri.fsPath, filePath)
+      );
+    });
+    if (hasUnsavedChanges) {
+      throw new Error(
+        "Save or discard unsaved changes before downloading: " + filePath
+      );
+    }
+  }
