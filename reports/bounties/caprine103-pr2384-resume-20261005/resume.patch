+	const canRecoverResume = (): boolean => !resumeDisposed
+		&& !isQuitting
+		&& !mainWindow.isDestroyed()
+		&& !webContents.isDestroyed();
+
+	const cancelResumeRecovery = (): void => {
+		resumeEpoch++;
+		resumePending = false;
+		if (resumeRetry !== undefined) {
+			clearTimeout(resumeRetry);
+			resumeRetry = undefined;
+		}
+	};
+
+	const checkResumeConnectivity = async (): Promise<void> => {
+		if (!resumePending || connectivityCheckRunning || !canRecoverResume()) {
+			return;
+		}
+
+		const epoch = resumeEpoch;
+		connectivityCheckRunning = true;
+		try {
+			// Failed connectivity checks are retried without a dialog or app exit.
+			const online = await isOnline().catch(() => false);
+			if (!canRecoverResume() || !resumePending || epoch !== resumeEpoch) {
+				return;
+			}
