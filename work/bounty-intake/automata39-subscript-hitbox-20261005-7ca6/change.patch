diff --git a/site/js/render.js b/site/js/render.js
--- a/site/js/render.js
+++ b/site/js/render.js
@@ -651,6 +651,46 @@
             return false;
         }
 
+        var deftext = '';
+        var subtext = '';
+        var findsubtext = false;
+        for ( var j = 0; j < text.length; ++j ) {
+            var character = text.charAt( j );
