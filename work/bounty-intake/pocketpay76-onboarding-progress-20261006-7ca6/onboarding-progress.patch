diff --git a/src/components/OnboardingProgress.tsx b/src/components/OnboardingProgress.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..b9cf3ec74e5a2f7807a07ca8a1fc5130d2c999c7
--- /dev/null
+++ b/src/components/OnboardingProgress.tsx
@@ -0,0 +1,86 @@
+import React, { useMemo } from 'react';
+import { StyleSheet, Text, View } from 'react-native';
+import { RADIUS, SIZES, ThemeColors } from '../constants/theme';
+import { useTheme } from '../hooks/useTheme';
+
+type OnboardingProgressProps =
+  | { flow: 'create'; stage: 'generate' | 'backup' | 'ready' }
+  | { flow: 'import'; stage: 'import' | 'ready' };
+
+const CREATE_STEPS = [
+  { title: 'Generate keys', next: 'Next: Back up your secret key, then open your wallet.' },
+  { title: 'Back up your key', next: 'Next: Confirm your backup to open your wallet.' },
+  { title: 'Wallet', next: 'Setup is complete. Testnet funding is available from Home.' },
+] as const;
+
+const IMPORT_STEPS = [
+  { title: 'Import key', next: 'Next: Validate and save your key, then open your wallet.' },
+  { title: 'Wallet', next: 'Setup is complete. Check your balance on Home.' },
+] as const;
+
+export function OnboardingProgress(props: OnboardingProgressProps) {
+  const { colors } = useTheme();
+  const styles = useMemo(() => createStyles(colors), [colors]);
+  const steps = props.flow === 'create' ? CREATE_STEPS : IMPORT_STEPS;
+  const currentIndex = props.stage === 'ready' ? steps.length - 1 : props.stage === 'backup' ? 1 : 0;
+  const current = steps[currentIndex] ?? steps[0];
+  const stepLabel = 'Step ' + (currentIndex + 1) + ' of ' + steps.length + ': ' + current.title;
+
+  return (
+    <View
+      style={styles.container}
+      accessible
+      accessibilityRole="progressbar"
+      accessibilityLabel={props.flow === 'create' ? 'Create wallet setup' : 'Import wallet setup'}
+      accessibilityValue={{ text: stepLabel + '. ' + current.next }}
+      accessibilityLiveRegion="polite"
+    >
+      <Text style={styles.label}>{stepLabel}</Text>
+      <View
+        style={styles.track}
+        accessible={false}
+        accessibilityElementsHidden
+        importantForAccessibility="no-hide-descendants"
+      >
+        {steps.map((step, index) => (
+          <View
+            key={step.title}
+            style={[styles.segment, index <= currentIndex && styles.activeSegment]}
+          />
+        ))}
+      </View>
+      <Text style={styles.next}>{current.next}</Text>
+    </View>
+  );
+}
+
+const createStyles = (colors: ThemeColors) => StyleSheet.create({
+  container: {
+    marginBottom: SIZES.lg,
+  },
+  label: {
+    color: colors.textPrimary,
+    fontSize: 14,
+    fontWeight: '600',
+    lineHeight: 20,
+  },
+  track: {
+    flexDirection: 'row',
+    gap: SIZES.sm,
+    marginVertical: SIZES.sm,
+  },
+  segment: {
+    flex: 1,
+    height: SIZES.xs,
+    borderRadius: RADIUS.round,
+    backgroundColor: colors.border,
+  },
+  activeSegment: {
+    backgroundColor: colors.primary,
+  },
+  next: {
+    color: colors.textSecondary,
+    fontSize: 14,
+    lineHeight: 20,
+  },
+});
