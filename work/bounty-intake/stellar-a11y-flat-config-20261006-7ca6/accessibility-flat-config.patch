+// Created 2026-10-06: apply the existing accessibility policy as a flat config.
+import { readFileSync } from "node:fs";
+import jsxA11y from "eslint-plugin-jsx-a11y";
+import baseConfig from "./eslint.config.mjs";
+
+const accessibilityPolicy = JSON.parse(
+  readFileSync(new URL("./.eslintrc.a11y.json", import.meta.url), "utf8"),
+);
+
+export default [
+  ...baseConfig,
+  {
+    rules: {
+      ...jsxA11y.flatConfigs.recommended.rules,
+      ...accessibilityPolicy.rules,
+    },
+  },
+  ...accessibilityPolicy.overrides,
+];
