+/* Keep localized content and its navbar aligned with the rendered sidebar. */
+.terminal-layout {
+  --sidebar-offset: 0rem;
+}
+
+.terminal-layout > main {
+  margin-left: var(--sidebar-offset);
+}
+
+@media (min-width: 48rem) {
+  .terminal-layout:has(> aside[data-sidebar-collapsed="true"]) {
+    --sidebar-offset: 5rem;
+  }
+
+  .terminal-layout:has(> aside[data-sidebar-collapsed="false"]) {
+    --sidebar-offset: 16rem;
+  }
+}
